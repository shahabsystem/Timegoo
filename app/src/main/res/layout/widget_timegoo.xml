<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="14dp"
    android:background="@drawable/bg_time">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="تایمگو • ساعت فعلی" android:textColor="#F6C35D"
        android:textStyle="bold" android:textSize="14sp"/>
    <TextView android:id="@+id/widgetClock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:text="۱۲:۳۴" android:textColor="#F6C35D"
        android:textStyle="bold" android:textSize="36sp"
        android:includeFontPadding="false"/>
    <TextView android:id="@+id/widgetDate" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="تاریخ میلادی: ۲۰۲۶/۱۰/۲۲"
        android:textColor="#E7ECF4" android:textSize="12sp"/>
</LinearLayout>
