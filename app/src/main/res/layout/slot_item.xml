<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/slotTitle" android:text="بازه ۱" android:textColor="@color/gold_light" android:textStyle="bold" android:textSize="16sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
<Switch android:id="@+id/enabled" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="50dp">
<Button android:id="@+id/start" android:text="شروع: ۰۷:۰۰" android:textColor="@color/text" android:background="@drawable/bg_outline_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
<Button android:id="@+id/end" android:text="پایان: ۱۰:۰۰" android:textColor="@color/text" android:background="@drawable/bg_outline_button" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/>
</LinearLayout>
<TextView android:id="@+id/intervalLabel" android:text="فاصله اعلام: ۶۰ دقیقه" android:textColor="@color/muted" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<SeekBar android:id="@+id/interval" android:max="119" android:progress="59" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>